APP_NAME="School Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development (zero-config): SQLite
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Production: PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=school_management
# DB_USERNAME=school
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Queue / cache
# ---------------------------------------------------------------------------
# Simple deployments:
QUEUE_CONNECTION=sync
CACHE_STORE=database
# Redis-backed (recommended for production):
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# true = seed a realistic demo school (5 classes, 120 students, attendance,
#        exams, marks, fees, library). false = production-safe seed only.
DEMO_SEED=false

VITE_APP_NAME="${APP_NAME}"
